[Unit]
Description=AI Gateway evaluation service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/code_room/ai_gateway_eval
# Install requirements first using scripts/start.sh, then use the venv directly.
ExecStart=/home/code_room/ai_gateway_eval/.venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 8080 --no-access-log
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
