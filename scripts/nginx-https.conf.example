# Replace eval.example.com and certificate paths before enabling this file.
# Frontend and API are both served by the same FastAPI instance.
server {
    listen 80;
    server_name eval.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name eval.example.com;
    ssl_certificate /etc/letsencrypt/live/eval.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/eval.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
    # Avoid logging URLs containing job capability IDs. Never log request bodies.
    location /api/evaluations {
        access_log off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
